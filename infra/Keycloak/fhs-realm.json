{
    "realm": "fhs",
    "enabled": true,
    "sslRequired": "none",
    "verifyEmail": false,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "roles": {
        "realm": [
            {
                "name": "admin",
                "description": "Full administrative access to FHS: user lockout, reference data, and (v2) language management."
            }
        ]
    },
    "clients": [
        {
            "clientId": "fhs-api",
            "enabled": true,
            "bearerOnly": true,
            "publicClient": false
        },
        {
            "clientId": "fhs-spa",
            "enabled": true,
            "publicClient": true,
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "*"
            ],
            "webOrigins": [
                "*"
            ],
            "protocolMappers": [
                {
                    "name": "fhs-api-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "config": {
                        "included.client.audience": "fhs-api",
                        "access.token.claim": "true"
                    }
                },
                {
                    "name": "realm-roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "config": {
                        "claim.name": "roles",
                        "jsonType.label": "String",
                        "multivalued": "true",
                        "access.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "users": [
        {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "operator",
            "enabled": true,
            "email": "operator@fhs.local",
            "emailVerified": true,
            "firstName": "Line",
            "lastName": "Operator",
            "requiredActions": [],
            "credentials": [
                {
                    "type": "password",
                    "value": "operator",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "default-roles-fhs"
            ]
        },
        {
            "id": "22222222-2222-4222-8222-222222222222",
            "username": "admin",
            "enabled": true,
            "email": "admin@fhs.local",
            "emailVerified": true,
            "firstName": "System",
            "lastName": "Administrator",
            "requiredActions": [],
            "credentials": [
                {
                    "type": "password",
                    "value": "admin",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "default-roles-fhs",
                "admin"
            ],
            "clientRoles": {
                "realm-management": [
                    "view-users",
                    "manage-users"
                ]
            }
        }
    ]
}