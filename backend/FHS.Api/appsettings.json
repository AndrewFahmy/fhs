{
  "ConnectionStrings": {
    "DbConnection": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "fhs-api"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../temp/fhs-api/logs/api-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}{NewLine}",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "OpenTelemetry"
      }
    ]
  }
}